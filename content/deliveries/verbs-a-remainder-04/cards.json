    "options": [
      {
        "id": "a",
        "text": "入れました",
        "reading": "いれました",
        "verdict": "correct",
        "explanation": "妈妈把茶叶放进茶壶，茶叶是移动对象，符合他动词入れる。"
      },
      {
        "id": "b",
        "text": "入りました",
        "reading": "はいりました",
        "verdict": "ungrammatical",
        "explanation": "本句用「茶葉を」标出被放入的对象；自动词入る描述茶叶自身进入，不能接这个宾语。"

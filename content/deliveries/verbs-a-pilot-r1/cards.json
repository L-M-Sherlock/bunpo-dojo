    "options": [
      {
        "id": "a",
        "text": "開きます",
        "reading": "あきます",
        "verdict": "correct",
        "explanation": "自动门是状态变化的主体，表示门因有人靠近而打开。"
      },
      {
        "id": "b",
        "text": "開けます",
        "reading": "あけます",
        "verdict": "meaning-mismatch",
        "explanation": "按他动词開ける理解，门会是打开别的东西的施事；这不表达自动门自身打开。"
      }

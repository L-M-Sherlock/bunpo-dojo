    "after": [
      {
        "text": "。",
        "reading": "。"
      }
    ],
    "options": [
      {
        "id": "a",
        "text": "始まりました",
        "reading": "はじまりました",
        "verdict": "correct",
        "explanation": "说明会作为活动本身在十点开始；始まる表达活动开始，不指定启动活动的人。"
      },
      {
        "id": "b",
        "text": "始めました",
        "reading": "はじめました",
        "verdict": "meaning-mismatch",
        "explanation": "始める表示某个施事开始一项活动；这里的主语是开始的说明会本身，不是启动另一项活动的人。"
      }
    ],
    "answerIds": [
      "a"
    ],
    "translation": "公司说明会于十点开始了。",
    "explanation": "句中写的是说明会这个活动开始，没有写由谁启动另一项活动。",
    "hint": "先看句子的主体是正在开始的活动，还是启动活动的一方。",

      {
        "text": "。",
        "reading": "。"
      }
    ],
    "options": [
      {
        "id": "a",
        "text": "出しました",
        "reading": "だしました",
        "verdict": "correct",
        "explanation": "妈妈把备用钥匙从抽屉里取出，钥匙是动作对象。"
      },
      {
        "id": "b",
        "text": "出ました",
        "reading": "でました",
        "verdict": "ungrammatical",
        "explanation": "本句用「予備の鍵を」标出被取出的对象；自动词出る描述钥匙自行出来，不能接该直接宾语。"
      }
    ],
    "answerIds": [
      "a"
    ],
    "translation": "妈妈从抽屉里拿出了备用钥匙。",
    "explanation": "出す（だす）表示妈妈把钥匙从抽屉中取出来。",
    "hint": "找出句中实施取出动作的人，以及被取出的物品。",

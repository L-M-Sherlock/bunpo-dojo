    "options": [
      {
        "id": "a",
        "text": "変えました",
        "reading": "かえました",
        "verdict": "correct",
        "explanation": "编辑主动把标题改短，见出し是被修改的内容，変える表达施事改变对象。"
      },
      {
        "id": "b",
        "text": "変わりました",
        "reading": "かわりました",
        "verdict": "ungrammatical",
        "explanation": "変わる表示内容本身发生变化，不能在这里接「見出しを」作直接宾语；若只报告标题发生变化，应改成「見出しが変わりました」。"
      }
    ],
    "answerIds": [

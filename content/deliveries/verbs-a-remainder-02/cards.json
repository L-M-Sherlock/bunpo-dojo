      }
    ],
    "options": [
      {
        "id": "a",
        "text": "壊しました",
        "reading": "こわしました",
        "verdict": "correct",
        "explanation": "工作人员是弄坏花瓶的施事，花瓶是动作对象。"
      },
      {
        "id": "b",
        "text": "壊れました",
        "reading": "こわれました",
        "verdict": "ungrammatical",
        "explanation": "本句把花瓶标为直接对象「を」；自动词壊れる描述物品自身损坏，不能接这个宾语。"
